<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Management Portal</title>
  <style>
    :root {
      --primary: #2563eb;
      --primary-hover: #1d4ed8;
      --bg: #f8fafc;
      --surface: #ffffff;
      --text: #0f172a;
      --border: #e2e8f0;
      --danger: #ef4444;
      --success: #10b981;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    }

    body {
      background-color: var(--bg);
      color: var(--text);
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      padding: 20px;
    }

    .container {
      width: 100%;
      max-width: 900px;
      background: var(--surface);
      border-radius: 8px;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
      padding: 24px;
    }

    .hidden { display: none !important; }

    /* Auth Forms */
    .auth-box {
      max-width: 400px;
      margin: 40px auto;
    }

    .form-group {
      margin-bottom: 16px;
    }

    label {
      display: block;
      margin-bottom: 6px;
      font-weight: 500;
      font-size: 14px;
    }

    input, select {
      width: 100%;
      padding: 10px;
      border: 1px solid var(--border);
      border-radius: 6px;
      font-size: 14px;
    }

    button {
      width: 100%;
      padding: 10px;
      background-color: var(--primary);
      color: white;
      border: none;
      border-radius: 6px;
      font-weight: 600;
      cursor: pointer;
      transition: background 0.2s;
    }

    button:hover { background-color: var(--primary-hover); }
    button.secondary { background-color: #64748b; }
    button.secondary:hover { background-color: #475569; }
    button.danger { background-color: var(--danger); }

    /* Dashboard */
    .header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-bottom: 16px;
      border-bottom: 1px solid var(--border);
      margin-bottom: 20px;
    }

    .nav-tabs {
      display: flex;
      gap: 10px;
      margin-bottom: 20px;
    }

    .nav-tabs button {
      width: auto;
      background: none;
      color: var(--text);
      border: 1px solid var(--border);
    }

    .nav-tabs button.active {
      background: var(--primary);
      color: white;
      border-color: var(--primary);
    }

    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 10px;
    }

    th, td {
      text-align: left;
      padding: 12px;
      border-bottom: 1px solid var(--border);
    }

    th { background-color: #f1f5f9; }

    .action-btn {
      width: auto;
      padding: 6px 12px;
      font-size: 12px;
      margin-right: 4px;
    }

    .auth-links {
      margin-top: 12px;
      text-align: center;
    }

    .auth-links a {
      color: var(--primary);
      font-size: 14px;
      text-decoration: none;
      cursor: pointer;
    }

    .modal {
      position: fixed;
      top: 0; left: 0; right: 0; bottom: 0;
      background: rgba(0,0,0,0.5);
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .modal-content {
      background: white;
      padding: 24px;
      border-radius: 8px;
      width: 100%;
      max-width: 400px;
    }
  </style>
</head>
<body>

<div class="container">
  <!-- LOGIN VIEW -->
  <div id="login-view" class="auth-box">
    <h2 style="margin-bottom: 20px; text-align: center;">Portal Login</h2>
    <form id="login-form">
      <div class="form-group">
        <label>Username</label>
        <input type="text" id="login-username" required>
      </div>
      <div class="form-group">
        <label>Password</label>
        <input type="password" id="login-password" required>
      </div>
      <button type="submit">Sign In</button>
    </form>
    <div class="auth-links">
      <a id="forgot-password-link">Forgot Master Admin Password?</a>
    </div>
  </div>

  <!-- MASTER ADMIN RECOVERY MODAL -->
  <div id="recovery-modal" class="modal hidden">
    <div class="modal-content">
      <h3 style="margin-bottom: 12px;">Master Admin Recovery</h3>
      <form id="recovery-form">
        <div class="form-group">
          <label>Security Question: What is your favourite color?</label>
          <input type="text" id="recovery-answer" placeholder="Enter answer" required>
        </div>
        <div class="form-group">
          <label>New Password</label>
          <input type="password" id="recovery-new-pass" required>
        </div>
        <button type="submit">Reset Password</button>
        <button type="button" class="secondary" id="close-recovery" style="margin-top: 8px;">Cancel</button>
      </form>
    </div>
  </div>

  <!-- MAIN DASHBOARD VIEW -->
  <div id="dashboard-view" class="hidden">
    <div class="header">
      <div>
        <h2>Management Dashboard</h2>
        <span id="user-badge" style="font-size: 12px; color: #64748b;"></span>
      </div>
      <button id="logout-btn" class="secondary" style="width: auto;">Logout</button>
    </div>

    <div class="nav-tabs">
      <button id="tab-products" class="active">Products</button>
      <button id="tab-users" class="hidden">User Management</button>
    </div>

    <!-- PRODUCTS PANEL -->
    <div id="panel-products">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
        <h3>Product Catalog</h3>
        <button id="add-product-btn" style="width: auto;">+ Add Product</button>
      </div>
      <table>
        <thead>
          <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Price ($)</th>
            <th>Stock</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody id="product-table-body"></tbody>
      </table>
    </div>

    <!-- USERS PANEL (Master Admin Only) -->
    <div id="panel-users" class="hidden">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
        <h3>System Users</h3>
        <button id="add-user-btn" style="width: auto;">+ Create User (Admin/Seller)</button>
      </div>
      <table>
        <thead>
          <tr>
            <th>Username</th>
            <th>Role</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody id="user-table-body"></tbody>
      </table>
    </div>
  </div>
</div>

<!-- PRODUCT MODAL (Add/Edit) -->
<div id="product-modal" class="modal hidden">
  <div class="modal-content">
    <h3 id="product-modal-title" style="margin-bottom: 12px;">Add Product</h3>
    <form id="product-form">
      <input type="hidden" id="product-id">
      <div class="form-group">
        <label>Product Name</label>
        <input type="text" id="product-name" required>
      </div>
      <div class="form-group">
        <label>Price</label>
        <input type="number" step="0.01" id="product-price" required>
      </div>
      <div class="form-group">
        <label>Stock</label>
        <input type="number" id="product-stock" required>
      </div>
      <button type="submit">Save Product</button>
      <button type="button" class="secondary" id="close-product-modal" style="margin-top: 8px;">Cancel</button>
    </form>
  </div>
</div>

<!-- USER MODAL (Add/Edit) -->
<div id="user-modal" class="modal hidden">
  <div class="modal-content">
    <h3 id="user-modal-title" style="margin-bottom: 12px;">User Account</h3>
    <form id="user-form">
      <input type="hidden" id="user-edit-original-username">
      <div class="form-group">
        <label>Username</label>
        <input type="text" id="user-username" required>
      </div>
      <div class="form-group">
        <label>Password</label>
        <input type="password" id="user-password" required>
      </div>
      <div class="form-group" id="role-select-group">
        <label>Role</label>
        <select id="user-role">
          <option value="admin">Admin</option>
          <option value="seller">Seller</option>
        </select>
      </div>
      <button type="submit">Save User</button>
      <button type="button" class="secondary" id="close-user-modal" style="margin-top: 8px;">Cancel</button>
    </form>
  </div>
</div>

<script>
  // --- INITIALIZATION & STORAGE ---
  const INITIAL_USERS = [
    { username: 'abdelmoty', pass: '1991990', role: 'master_admin', question: 'What is your favourite color?', answer: 'blue' }
  ];

  const INITIAL_PRODUCTS = [
    { id: '101', name: 'Sample Item A', price: 29.99, stock: 50 },
    { id: '102', name: 'Sample Item B', price: 49.99, stock: 15 }
  ];

  function loadData(key, fallback) {
    const data = localStorage.getItem(key);
    return data ? JSON.parse(data) : fallback;
  }

  function saveData(key, data) {
    localStorage.setItem(key, JSON.stringify(data));
  }

  let users = loadData('portal_users', INITIAL_USERS);
  let products = loadData('portal_products', INITIAL_PRODUCTS);
  let currentUser = null;

  saveData('portal_users', users);
  saveData('portal_products', products);

  // --- DOM ELEMENTS ---
  const loginView = document.getElementById('login-view');
  const dashboardView = document.getElementById('dashboard-view');
  const userBadge = document.getElementById('user-badge');
  const tabProducts = document.getElementById('tab-products');
  const tabUsers = document.getElementById('tab-users');
  const panelProducts = document.getElementById('panel-products');
  const panelUsers = document.getElementById('panel-users');

  // --- AUTHENTICATION ---
  document.getElementById('login-form').addEventListener('submit', (e) => {
    e.preventDefault();
    const u = document.getElementById('login-username').value;
    const p = document.getElementById('login-password').value;

    const account = users.find(x => x.username === u && x.pass === p);
    if (account) {
      currentUser = account;
      document.getElementById('login-form').reset();
      showDashboard();
    } else {
      alert('Invalid username or password.');
    }
  });

  document.getElementById('logout-btn').addEventListener('click', () => {
    currentUser = null;
    dashboardView.classList.add('hidden');
    loginView.classList.remove('hidden');
  });

  // Master Admin Recovery
  document.getElementById('forgot-password-link').addEventListener('click', () => {
    document.getElementById('recovery-modal').classList.remove('hidden');
  });

  document.getElementById('close-recovery').addEventListener('click', () => {
    document.getElementById('recovery-modal').classList.add('hidden');
  });

  document.getElementById('recovery-form').addEventListener('submit', (e) => {
    e.preventDefault();
    const ans = document.getElementById('recovery-answer').value.trim().toLowerCase();
    const newPass = document.getElementById('recovery-new-pass').value;

    const master = users.find(u => u.role === 'master_admin');
    if (ans === master.answer.toLowerCase()) {
      master.pass = newPass;
      saveData('portal_users', users);
      alert('Master Admin password successfully updated!');
      document.getElementById('recovery-modal').classList.add('hidden');
      document.getElementById('recovery-form').reset();
    } else {
      alert('Incorrect security answer.');
    }
  });

  // --- UI NAVIGATION ---
  function showDashboard() {
    loginView.classList.add('hidden');
    dashboardView.classList.remove('hidden');
    userBadge.textContent = `Logged in as: ${currentUser.username} (${currentUser.role.replace('_', ' ').toUpperCase()})`;

    if (currentUser.role === 'master_admin') {
      tabUsers.classList.remove('hidden');
    } else {
      tabUsers.classList.add('hidden');
    }

    switchTab('products');
    renderProducts();
    if (currentUser.role === 'master_admin') renderUsers();
  }

  function switchTab(tab) {
    if (tab === 'products') {
      tabProducts.classList.add('active');
      tabUsers.classList.remove('active');
      panelProducts.classList.remove('hidden');
      panelUsers.classList.add('hidden');
    } else {
      tabUsers.classList.add('active');
      tabProducts.classList.remove('active');
      panelUsers.classList.remove('hidden');
      panelProducts.classList.add('hidden');
    }
  }

  tabProducts.addEventListener('click', () => switchTab('products'));
  tabUsers.addEventListener('click', () => switchTab('users'));

  // --- PRODUCTS MANAGEMENT ---
  function renderProducts() {
    const tbody = document.getElementById('product-table-body');
    tbody.innerHTML = '';

    products.forEach(p => {
      const tr = document.createElement('tr');
      
      let actionsHTML = '';
      if (currentUser.role === 'master_admin' || currentUser.role === 'admin') {
        actionsHTML += `<button class="action-btn" onclick="editProduct('${p.id}')">Edit</button>`;
      }
      if (currentUser.role === 'master_admin') {
        actionsHTML += `<button class="action-btn danger" onclick="deleteProduct('${p.id}')">Delete</button>`;
      }
      if (currentUser.role === 'seller') {
        actionsHTML = `<span style="font-size: 12px; color: #64748b;">Read Only</span>`;
      }

      tr.innerHTML = `
        <td>${p.id}</td>
        <td>${p.name}</td>
        <td>$${Number(p.price).toFixed(2)}</td>
        <td>${p.stock}</td>
        <td>${actionsHTML}</td>
      `;
      tbody.appendChild(tr);
    });

    document.getElementById('add-product-btn').style.display = 
      (currentUser.role === 'seller') ? 'none' : 'inline-block';
  }

  document.getElementById('add-product-btn').addEventListener('click', () => {
    document.getElementById('product-modal-title').textContent = 'Add Product';
    document.getElementById('product-id').value = '';
    document.getElementById('product-form').reset();
    document.getElementById('product-modal').classList.remove('hidden');
  });

  window.editProduct = function(id) {
    const p = products.find(prod => prod.id === id);
    if (!p) return;
    document.getElementById('product-modal-title').textContent = 'Edit Product';
    document.getElementById('product-id').value = p.id;
    document.getElementById('product-name').value = p.name;
    document.getElementById('product-price').value = p.price;
    document.getElementById('product-stock').value = p.stock;
    document.getElementById('product-modal').classList.remove('hidden');
  };

  window.deleteProduct = function(id) {
    if (confirm('Delete this product?')) {
      products = products.filter(p => p.id !== id);
      saveData('portal_products', products);
      renderProducts();
    }
  };

  document.getElementById('close-product-modal').addEventListener('click', () => {
    document.getElementById('product-modal').classList.add('hidden');
  });

  document.getElementById('product-form').addEventListener('submit', (e) => {
    e.preventDefault();
    const id = document.getElementById('product-id').value;
    const name = document.getElementById('product-name').value;
    const price = parseFloat(document.getElementById('product-price').value);
    const stock = parseInt(document.getElementById('product-stock').value, 10);

    if (id) {
      const p = products.find(prod => prod.id === id);
      p.name = name;
      p.price = price;
      p.stock = stock;
    } else {
      products.push({ id: Date.now().toString().slice(-4), name, price, stock });
    }

    saveData('portal_products', products);
    renderProducts();
    document.getElementById('product-modal').classList.add('hidden');
  });

  // --- USER MANAGEMENT (Master Admin Only) ---
  function renderUsers() {
    const tbody = document.getElementById('user-table-body');
    tbody.innerHTML = '';

    users.forEach(u => {
      const tr = document.createElement('tr');
      let actionsHTML = '';

      if (u.role !== 'master_admin') {
        actionsHTML = `
          <button class="action-btn" onclick="editUser('${u.username}')">Edit Credentials</button>
          <button class="action-btn danger" onclick="deleteUser('${u.username}')">Delete</button>
        `;
      } else {
        actionsHTML = `<span style="font-size: 12px; color: #64748b;">Master Account</span>`;
      }

      tr.innerHTML = `
        <td>${u.username}</td>
        <td>${u.role.toUpperCase()}</td>
        <td>${actionsHTML}</td>
      `;
      tbody.appendChild(tr);
    });
  }

  document.getElementById('add-user-btn').addEventListener('click', () => {
    document.getElementById('user-modal-title').textContent = 'Create User Account';
    document.getElementById('user-edit-original-username').value = '';
    document.getElementById('role-select-group').classList.remove('hidden');
    document.getElementById('user-form').reset();
    document.getElementById('user-modal').classList.remove('hidden');
  });

  window.editUser = function(username) {
    const u = users.find(x => x.username === username);
    if (!u) return;

    document.getElementById('user-modal-title').textContent = 'Edit User Credentials';
    document.getElementById('user-edit-original-username').value = u.username;
    document.getElementById('user-username').value = u.username;
    document.getElementById('user-password').value = u.pass;
    document.getElementById('user-role').value = u.role;
    document.getElementById('role-select-group').classList.add('hidden');
    document.getElementById('user-modal').classList.remove('hidden');
  };

  window.deleteUser = function(username) {
    if (confirm(`Are you sure you want to delete user ${username}?`)) {
      users = users.filter(u => u.username !== username);
      saveData('portal_users', users);
      renderUsers();
    }
  };

  document.getElementById('close-user-modal').addEventListener('click', () => {
    document.getElementById('user-modal').classList.add('hidden');
  });

  document.getElementById('user-form').addEventListener('submit', (e) => {
    e.preventDefault();
    const origUsername = document.getElementById('user-edit-original-username').value;
    const username = document.getElementById('user-username').value.trim();
    const pass = document.getElementById('user-password').value;
    const role = document.getElementById('user-role').value;

    if (origUsername) {
      const u = users.find(x => x.username === origUsername);
      if (origUsername !== username && users.some(x => x.username === username)) {
        alert('Username already exists!');
        return;
      }
      u.username = username;
      u.pass = pass;
    } else {
      if (users.some(x => x.username === username)) {
        alert('Username already exists!');
        return;
      }
      if (role === 'master_admin') {
        alert('Cannot create additional Master Admin accounts.');
        return;
      }
      users.push({ username, pass, role });
    }

    saveData('portal_users', users);
    renderUsers();
    document.getElementById('user-modal').classList.add('hidden');
  });
</script>
</body>
</html>
